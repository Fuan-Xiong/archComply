# ===== 模型（B1 使用，勿写进代码）=====
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# 采样参数（复跑一致性：演示时固定低温度）
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_CONCURRENCY=2

# ===== 服务 =====
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# 单次评审：最大规划轮次 / 单步超时(ms) / 重试上限
HARNESS_MAX_ROUNDS=3
HARNESS_STEP_TIMEOUT_MS=90000
HARNESS_RETRY=1

# ===== 文档与规则 =====
WORKSPACE_DIR=./workspace
RULES_FILE=docs/rules清单.md
RULE_SET_ID=default

# ===== 前端（Vite）=====
# 指向 mock: http://localhost:8787 ; 指向真实后端: http://localhost:8080
VITE_API_BASE=http://localhost:8787
