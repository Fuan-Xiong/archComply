# agent-server 环境变量示例 —— 复制为 .env（需自行 export/加载）或直接注入进程
# 说明：本模块不自动读取 .env 文件（保持零依赖），请用 dotenv-cli / export / 进程级注入。

# ── 必填（缺失 → 启动期 fail fast，import server 即报错）────
QWEN_API_KEY=sk-your-key-here            # qwen code SDK 使用的 API Key
MODEL_NAME=qwen-max                      # 模型名

# ── 可选 ────────────────────────────────────────────────
QWEN_BASE_URL=                            # SDK 网关地址；留空用 SDK 默认

HOST=127.0.0.1
PORT=4170                                 # 默认端口（与 B1 的 8080 隔离）

MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=4096

# Harness 编排参数（外部调用超时/重试/并发/最大轮次）
HARNESS_TIMEOUT_MS=90000
HARNESS_RETRIES=2
HARNESS_CONCURRENCY=2
HARNESS_MAX_ROUNDS=3

# SSE 心跳间隔
SSE_KEEPALIVE_MS=15000

LOG_LEVEL=info                            # debug/info/warn/error/silent
WORKSPACE_DIR=./.agent-runs